---
// Small hand-drawn-style quantum line icons, matching the clean pink
// linework of the science page's "popular examples" illustrations.
// Used as interim avatars for team members awaiting photos, plus a
// hand-drawn Discord mark for the "…and more" card. Color comes from
// currentColor so the parent sets the tint.
interface Props {
  name: "atom" | "molecule" | "spin" | "wave" | "discord";
  size?: number;
}

const { name, size = 44 } = Astro.props;
---

{
  name === "atom" && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 48 48"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <ellipse cx="24" cy="24" rx="16" ry="6.5" />
      <ellipse cx="24" cy="24" rx="16" ry="6.5" transform="rotate(60 24 24)" />
      <ellipse cx="24" cy="24" rx="16" ry="6.5" transform="rotate(120 24 24)" />
      <circle cx="24" cy="24" r="2" fill="currentColor" stroke="none" />
      <circle cx="35" cy="15" r="1.4" fill="currentColor" stroke="none" />
    </svg>
  )
}

{
  name === "molecule" && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 48 48"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M24 9 L37 16.5 L37 31.5 L24 39 L11 31.5 L11 16.5 Z" />
      <circle cx="24" cy="24" r="6" />
      <circle cx="37" cy="16.5" r="1.6" fill="currentColor" stroke="none" />
      <circle cx="11" cy="31.5" r="1.6" fill="currentColor" stroke="none" />
      <circle cx="24" cy="9" r="1.6" fill="currentColor" stroke="none" />
    </svg>
  )
}

{
  name === "spin" && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 48 48"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <line x1="18" y1="12" x2="18" y2="36" />
      <polyline points="13,19 18,12 23,19" />
      <line x1="30" y1="12" x2="30" y2="36" />
      <polyline points="25,29 30,36 35,29" />
    </svg>
  )
}

{
  name === "wave" && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 48 48"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M5 24 C 8 24, 9 23, 11 24 C 13 17, 16 17, 18 24 C 20 32, 23 32, 25 24 C 27 13, 30 13, 32 24 C 34 31, 36 31, 38 24 C 40 23, 41 24, 43 24" />
      <circle cx="24" cy="10" r="1.5" fill="currentColor" stroke="none" />
    </svg>
  )
}

{
  name === "discord" && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 48 48"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M19 14.5 C 17.5 14.7, 15.7 15.2, 14 16 C 10.5 21.5, 9.3 27.5, 9.8 32.5 C 12.8 34.8, 15.8 36.2, 18.7 36.8 L 20.2 33.9 C 18.6 33.4, 17 32.7, 15.6 31.7 C 20.8 34.2, 27.2 34.2, 32.4 31.7 C 31 32.7, 29.4 33.4, 27.8 33.9 L 29.3 36.8 C 32.2 36.2, 35.2 34.8, 38.2 32.5 C 38.7 27.5, 37.5 21.5, 34 16 C 32.3 15.2, 30.5 14.7, 29 14.5 L 28.3 16 C 25.5 15.5, 22.5 15.5, 19.7 16 Z" />
      <ellipse cx="19.5" cy="26" rx="2.2" ry="2.6" fill="currentColor" stroke="none" />
      <ellipse cx="28.5" cy="26" rx="2.2" ry="2.6" fill="currentColor" stroke="none" />
    </svg>
  )
}
