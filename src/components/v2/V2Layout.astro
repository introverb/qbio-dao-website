---
import Layout from "../../layouts/Layout.astro";
import V2Header from "./V2Header.astro";
import Footer from "../Footer.astro";
import { waveBg, WAVE_TILE_W, WAVE_TILE_H } from "../../lib/v2-bg";
import { socials } from "../../lib/socials";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<Layout title={title} description={description}>
  <!-- Shared "pencil" SVG filter — applied to every hand-drawn icon and
       illustration via filter="url(#pencil-*)" so the lines wobble like a
       pencil sketch instead of staying perfectly geometric. Three tuned
       variants because feDisplacementMap scale lives in viewBox units, so
       the same scale reads way bigger on a 24-viewBox icon than a
       120-viewBox illustration. -->
  <svg
    width="0"
    height="0"
    style="position:absolute;width:0;height:0;overflow:hidden"
    aria-hidden="true"
  >
    <defs>
      <filter id="pencil-sm" x="-20%" y="-20%" width="140%" height="140%">
        <feTurbulence type="fractalNoise" baseFrequency="0.12" numOctaves="2" seed="3" stitchTiles="noStitch"/>
        <feDisplacementMap in="SourceGraphic" scale="2.5"/>
      </filter>
      <filter id="pencil-md" x="-20%" y="-20%" width="140%" height="140%">
        <feTurbulence type="fractalNoise" baseFrequency="0.06" numOctaves="2" seed="5" stitchTiles="noStitch"/>
        <feDisplacementMap in="SourceGraphic" scale="5"/>
      </filter>
      <filter id="pencil-lg" x="-20%" y="-20%" width="140%" height="140%">
        <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="7" stitchTiles="noStitch"/>
        <feDisplacementMap in="SourceGraphic" scale="9"/>
      </filter>
    </defs>
  </svg>
  <V2Header />
  <main class="bg-plum-darkest text-cream relative overflow-hidden">
    <!-- Bg layer 1: tileable sine waves (wave-interference reference) -->
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.10]"
      style={`background-image: ${waveBg}; background-size: ${WAVE_TILE_W}px ${WAVE_TILE_H}px;`}
      aria-hidden="true"
    >
    </div>
    <!-- Bg layer 2: subtle dot grid on top -->
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.07]"
      style="background-image: radial-gradient(circle, #fffcf6 1px, transparent 1px); background-size: 22px 22px;"
      aria-hidden="true"
    >
    </div>

    <!-- Social icons — pinned just under the nav, right-aligned with the
         last nav item. Shown on every v2 page. -->
    <div
      class="absolute inset-x-0 z-40 pointer-events-none"
      style="top: 5.5rem;"
      aria-label="Social links"
    >
      <div class="max-w-7xl mx-auto px-6 lg:px-12 flex justify-end">
        <div
          class="flex items-center gap-5 bg-plum-deepest/50 backdrop-blur-sm rounded-lg px-4 py-2 pointer-events-auto"
        >
          {
            socials.map((s) => {
              const isMail = s.href.startsWith("mailto:");
              return (
                <a
                  href={s.href}
                  aria-label={s.label}
                  target={isMail ? undefined : "_blank"}
                  rel={isMail ? undefined : "noopener noreferrer"}
                  class="text-cream/40 hover:text-pink transition-colors"
                >
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d={s.path} />
                  </svg>
                </a>
              );
            })
          }
        </div>
      </div>
    </div>

    <slot />
  </main>
  <Footer />
</Layout>
