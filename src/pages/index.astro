---
import V2Layout from "../components/v2/V2Layout.astro";
import V2Cta from "../components/v2/V2Cta.astro";
import EyebrowLabel from "../components/v2/EyebrowLabel.astro";
import { bentoCard, bentoHeading } from "../lib/v2-bg";
import { getQubieCards, QUBIE_SITE_URL } from "../lib/qubie";

// Pulled at build time — top 3 research items + a 5-wide bottom strip
// mixing 4 chatter items and 1 video, sorted newest-first.
const { research: qubieResearch, chatter: qubieChatter } = await getQubieCards(
  3,
  4,
  1,
);
const qubieTotal = qubieResearch.length + qubieChatter.length;

// Deterministic per-article hash — used to give each Qubie card a unique
// doc-ID and a different scanline offset so the cards shimmer asynchronously.
function qubieHash(s: string): number {
  let h = 5381;
  for (let i = 0; i < s.length; i++) h = ((h * 33) ^ s.charCodeAt(i)) >>> 0;
  return h;
}

// Headline stats for the TL;DR panel (sourced from the DAO explainer).
const tldrStats = [
  { value: "$6.8M", label: "Raised in the token auction", accent: "pink" },
  { value: "500 ETH", label: "First major grant", accent: "teal" },
  { value: "50+", label: "Active contributors", accent: "pink" },
  {
    value: "30+",
    label: "Governance proposals passed by the community",
    accent: "pink",
  },
] as const;

// Merch — small curated feature pulled from the DAO's Printful storefront.
const MERCH_STORE_URL = "https://quantum-bio-dao.printful.me/";
const merchProducts = [
  {
    name: "Black Glossy Mug",
    slug: "black-glossy-mug",
    minPrice: 8.5,
    imageUrl:
      "https://cdn.printful.me/t/quick-stores/products/18108555-300-6a1f2934f3d4a",
  },
  {
    name: "Bucket Hat",
    slug: "bucket-hat",
    minPrice: 16.5,
    imageUrl:
      "https://cdn.printful.me/t/quick-stores/products/18108555-379-6a1f2685933f4",
  },
  {
    name: "Clear Phone Case",
    slug: "clear-case-for-iphone",
    minPrice: 12,
    imageUrl:
      "https://cdn.printful.me/t/quick-stores/products/18108555-181-6a1f22c98b5bc",
  },
  {
    name: "Unisex Hoodie",
    slug: "unisex-hoodie",
    minPrice: 28,
    imageUrl:
      "https://cdn.printful.me/t/quick-stores/products/18108555-380-6a0564247c7e4",
  },
];

type Org = {
  name: string;
  eyebrow: string;
  body: string;
  accent: "pink" | "teal";
  youAreHere: boolean;
  cta?: string;
  href?: string;
  external?: boolean;
};

const orgs: Org[] = [
  {
    name: "Quantum Biology Ecosystem",
    eyebrow: "Synergy",
    body: "The Quantum Biology Ecosystem is a cooperative initiative between 3 organizations synergistically building the quantum biology industry by design.",
    cta: "Visit Site",
    href: "https://quantumbiology.eco/",
    external: true,
    accent: "pink",
    youAreHere: false,
  },
  {
    name: "Quantum Biology DAO",
    eyebrow: "Governance",
    body: "The Quantum Biology DAO accelerates the quantum biology field through community building, open governance, scientific experimentation, research grants, and IP development.",
    cta: "Join the Community",
    href: "https://quantumbiology.community",
    external: true,
    accent: "pink",
    youAreHere: true,
  },
  {
    name: "Quantum Biology Institute",
    eyebrow: "Research",
    body: "The Quantum Biology Institute is a 501(c)(3) California non-profit that performs the basic research underpinning the field.",
    cta: "Visit Site",
    href: "https://quantumbiology.org",
    external: true,
    accent: "teal",
    youAreHere: false,
  },
  {
    name: "Quantum Biology Incubator",
    eyebrow: "Commercialization",
    body: "The QuantumBiology Incubator is a for-profit Delaware C-Corp that develops the technical workforce the industry needs while incubating the first batch of quantum biology startups.",
    cta: "Visit Site",
    href: "https://quantumbiology.inc/",
    external: true,
    accent: "pink",
    youAreHere: false,
  },
];

const accentTextClass = {
  pink: "text-pink",
  teal: "text-teal",
} as const;

const accentItalicClass = {
  pink: "text-pink/90",
  teal: "text-teal/90",
} as const;

const members = [
  {
    name: "Dr. Clarice D. Aiello",
    role: "Founder",
    img: "/images/team/clarice.jpeg",
    summary:
      "Quantum engineer exploring how quantum physics informs biology at the nanoscale.",
    bio: "Clarice is a quantum engineer interested in how quantum physics informs biology at the nanoscale. Born and raised in Brazil, Clarice obtained a Diplome d'Ingenieur in Physics from the Ecole Polytechnique in France and an M.Phil. in Physics from the University of Cambridge, Trinity College, in England; she received her Ph.D. from MIT in Electrical Engineering. She further held postdoctoral appointments in Bioengineering at Stanford, and in Chemistry at Berkeley.",
  },
  {
    name: "Dr. Geoff Anders",
    role: "Founder",
    img: "/images/team/geoff.jpeg",
    summary:
      "CEO of the Quantum Biology Institute and founder of Leverage, focused on supporting revolutionary scientific research.",
    bio: "Geoff Anders is the founder and CEO of Leverage, a research institute established in 2011 to support revolutionary scientific research. With a background in philosophy and social science, he leads Leverage's internal research and helps external research teams organize to make important scientific breakthroughs. His recent work focuses on the intersection of philosophy, science, and history, as it pertains especially to introspection, cognitive science, and artificial intelligence. Geoff is now the CEO of the Quantum Biology Institute and holds a PhD in Philosophy from Rutgers University and a BS in Economics from the Wharton School at the University of Pennsylvania.",
  },
  {
    name: "Dr. Alessandro Lodesani",
    role: "Founder",
    img: "/images/team/ale.jpeg",
    summary:
      "COO of the Quantum Biology Institute, designing innovative lab equipment and optimizing research operations.",
    bio: "Alessandro Lodesani is the Institute's Chief Operating Officer, overseeing its daily research operations. With a strong background in physics and engineering, combined with extensive experience in biology research, Alessandro focuses on designing innovative devices and optimizing lab processes. Originally from Italy, Alessandro earned a Bachelor's in Mechanical Engineering and a PhD in Physics, graduating with honors from the Polytechnic University of Milan, with a specialization in spintronics and molecular interfaces. His previous research at MIT focused on topological qubits and superconducting thin films, where he successfully developed the world's most efficient superconducting diode platform. Alessandro then joined the Institute in its early days at UCLA, where he led several projects investigating the influence of weak magnetic fields on biological systems.",
  },
  {
    name: "Jennilyn Gaitan",
    role: "Operations",
    img: "/images/team/jen.jpeg",
    summary:
      "Operations and administration lead for the Quantum Biology Institute, with two decades of experience refining systems and processes.",
    bio: "Jennilyn Gaitan graduated with a Bachelor of Science in Electronic Media and Film from Towson University. Since 2004, she has worked in various administrative and operational roles across multiple industries, including retail, higher education, photography, real estate, and small business operations. Jennilyn has a passion for creating and refining the systems and processes that businesses use, to run most efficiently, which has been a hallmark of her career. In November 2023, Jennilyn joined the Quantum Biology Institute, contributing her expertise to the administration and operations of the Institute.",
  },
  {
    name: "Kyra Gardner",
    role: "Media Director",
    img: "/images/team/kyra.jpeg",
    summary:
      "Communications Working Group Leader and co-founder of Smarter with Science, connecting complex topics to broader audiences.",
    bio: "Kyra Gardner is the Communications Working Group Leader for the Quantum Biology DAO, where she manages communications and social media. She joined the DAO in January of 2025 and carries out this work through Smarter with Science, a company she co-founded whose team members are also deeply involved in the quantum biology ecosystem. Despite not having as technical of a science background as some of her DAO peers, she enjoys finding ways to connect complex topics to everyday life and make them accessible to broader audiences.",
  },
];
---

<V2Layout
  title="Quantum Biology DAO"
  description="A global community advancing quantum biology research."
>
  <!-- ====================================================================== -->
  <!-- HERO  —  cube graphic anchored top-right, title on the left              -->
  <!-- ====================================================================== -->
  <section class="relative pb-16 md:pb-24">
    <!-- Cube graphic — enters from upper-right corner -->
    <div
      class="relative pt-20 lg:pt-0 lg:absolute lg:top-0 lg:right-0 lg:w-[55%] xl:w-[48%] lg:translate-x-[8%] pointer-events-none"
      style="opacity: 0.32;"
    >
      <img
        src="/images/graphics/cube-cutout.png"
        alt=""
        class="block w-full max-w-none"
        loading="eager"
      />
    </div>

    <!-- Title block on the left -->
    <div
      class="relative max-w-7xl mx-auto px-6 lg:px-12 pt-8 lg:pt-32 z-10"
    >
      <div class="lg:max-w-[58%]">
        <EyebrowLabel accent="pink">Quantum Biology DAO</EyebrowLabel>
        <h1
          class="font-display text-5xl sm:text-6xl lg:text-7xl xl:text-[5rem] leading-[0.95] tracking-tight text-cream"
        >
          A global
          <em class="italic text-pink/90">community</em>
          <span class="block">
            advancing quantum biology research.
          </span>
        </h1>
        <p
          class="mt-8 font-sans text-[14px] text-cream/65 leading-relaxed max-w-md"
        >
          The Quantum Biology DAO accelerates the quantum biology field through
          community building, open governance, scientific experimentation,
          research grants, and IP development. Together we will understand biology
          at the quantum level. Check out our <a
            href="#"
            class="text-pink hover:text-pink-light underline underline-offset-2"
            >vision paper</a
          >.
        </p>
        <div class="mt-10 flex flex-col items-start gap-5">
          <V2Cta
            href="/qbio-token#how-to-buy"
            label="Get QBIO governance tokens"
            accent="pink"
          />
          <V2Cta
            href="https://quantumbiology.community"
            label="Join the community"
            accent="pink"
            external
          />
        </div>
      </div>
    </div>

  </section>

  <!-- ====================================================================== -->
  <!-- BENTO REGION                                                            -->
  <!-- ====================================================================== -->
  <div class="relative max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid lg:grid-cols-12 gap-6 lg:gap-7 auto-rows-auto">

      <!-- ============================================================= -->
      <!-- AT A GLANCE — quick summary + headline stats            GOLD   -->
      <!-- ============================================================= -->
      <article class={`${bentoCard} lg:col-span-12`}>
        <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
          <div class="lg:col-span-5">
            <EyebrowLabel accent="pink">At a glance</EyebrowLabel>
            <h2 class={bentoHeading}>
              A community advancing
              <em class="italic text-pink/90">quantum biology</em>, governed by
              QBIO.
            </h2>
            <p
              class="mt-6 font-sans text-[14px] text-cream/70 leading-relaxed max-w-md"
            >
              A community-run organization advancing the field of quantum
              biology, governed by the QBIO token. The DAO funds research,
              builds open tools, and welcomes anyone who wants to help.
            </p>
            <div class="mt-8 flex flex-col items-start gap-5">
              <V2Cta
                href="/explainer"
                label="Read the full explainer"
                accent="pink"
              />
              <V2Cta
                href="https://quantumbiology.community"
                label="Join the community"
                accent="pink"
                external
              />
            </div>
          </div>
          <div class="lg:col-span-7">
            <div class="grid grid-cols-2 gap-5 md:gap-6 auto-rows-fr">
              {
                tldrStats.map((s) => (
                  <div class="rounded-lg border border-cream/10 bg-plum-deepest/40 p-6 md:p-8">
                    <p
                      class:list={[
                        "font-display text-3xl md:text-4xl lg:text-5xl leading-none",
                        accentTextClass[s.accent],
                      ]}
                    >
                      {s.value}
                    </p>
                    <p class="font-sans text-[11px] md:text-[12px] tracking-[0.12em] uppercase text-cream/55 mt-3 leading-snug">
                      {s.label}
                    </p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </article>

      <!-- ============================================================= -->
      <!-- THE ECOSYSTEM (Org Map) — moved above Featured Grantee  TEAL   -->
      <!-- ============================================================= -->
      <article class={`${bentoCard} lg:col-span-12`}>
        <div class="mb-10">
          <EyebrowLabel accent="pink" class="mb-4">The ecosystem</EyebrowLabel>
          <h2 class={`${bentoHeading} max-w-3xl`}>
            Where we sit in the <em class="italic text-pink/90">quantum biology</em> world.
          </h2>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5 md:gap-6">
          {
            orgs.map((org) => (
              <article class="flex flex-col rounded-lg border border-cream/10 bg-plum-deepest/40 p-6 md:p-7 relative">
                {org.youAreHere && (
                  <span
                    class="absolute inline-flex items-center px-3 py-1.5 rounded-full bg-pink text-plum-darkest font-sans text-[10px] font-bold tracking-[0.18em] uppercase whitespace-nowrap"
                    style="top: 0; left: 50%; transform: translate(-50%, -50%);"
                  >
                    You are here
                  </span>
                )}
                <p
                  class:list={[
                    "font-sans text-[10px] tracking-[0.25em] uppercase mb-4",
                    accentTextClass[org.accent],
                  ]}
                >
                  {org.eyebrow}
                </p>
                <h3 class="font-display text-xl md:text-2xl text-cream mb-4 leading-tight">
                  {org.name}
                </h3>
                <p class="font-sans text-[13px] text-cream/65 leading-relaxed mb-6 grow">
                  {org.body}
                </p>
                {org.cta && org.href && (
                  <V2Cta
                    href={org.href}
                    label={org.cta}
                    accent={org.accent}
                    external={org.external}
                    size="sm"
                  />
                )}
              </article>
            ))
          }
        </div>
      </article>

      <!-- ============================================================= -->
      <!-- FEATURED GRANTEE — Quantum Biology Institute             TEAL  -->
      <!-- ============================================================= -->
      <article class={`${bentoCard} lg:col-span-12`}>
        <EyebrowLabel accent="teal">Featured grantee</EyebrowLabel>
        <div class="grid lg:grid-cols-[1fr_1.3fr] gap-10 lg:gap-14 items-center mt-2">
          <div class="aspect-square rounded-lg overflow-hidden">
            <img
              src="/images/brand/qbi-institute-lockup.png"
              alt="Quantum Biology Institute"
              class="w-full h-full object-cover"
            />
          </div>
          <div>
            <h2 class={`${bentoHeading} mb-6`}>
              The Quantum Biology
              <em class="italic text-teal/90">Institute</em>.
            </h2>
            <div
              class="font-sans text-[14px] text-cream/75 leading-relaxed space-y-4"
            >
              <p>
                We made the largest grant ever awarded in quantum biology to
                the Quantum Biology Institute — a nonprofit lab in Los Angeles
                funding real scientists doing real experiments.
              </p>
              <p>
                The Institute is building a quantum microscope to detect
                electron spin states inside live cells.
              </p>
            </div>
            <div class="mt-8 flex flex-col items-start gap-5">
              <V2Cta
                href="https://quantumbiology.org"
                label="Visit the Institute"
                accent="teal"
                external
              />
              <p class="font-sans text-[12px] text-cream/60 leading-relaxed">
                The Quantum Biology Institute is committed to an open science
                model of research. To view all their previous and ongoing
                work, check out
                <a
                  href="https://data.quantumbiology.org/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-teal hover:text-teal/80 underline underline-offset-2"
                  >this link</a
                >.
              </p>
            </div>
          </div>
        </div>
      </article>

      <!-- ============================================================= -->
      <!-- QUBIE NEWS (build-time feed from the Qubie Report)      PINK   -->
      <!-- ============================================================= -->
      <article
        class="lg:col-span-12 overflow-hidden rounded-lg border border-cream/15 bg-plum-deepest/40"
      >
        {/* Console title bar */}
        <div
          class="flex flex-wrap items-center justify-between gap-3 border-b border-cream/10 bg-plum-darkest/70 px-5 py-2.5"
        >
          <div class="flex items-center gap-2.5">
            <span class="relative flex h-2 w-2" aria-hidden="true">
              <span
                class="absolute inline-flex h-full w-full rounded-full bg-pink opacity-50 animate-ping"
              ></span>
              <span
                class="relative inline-flex h-2 w-2 rounded-full bg-pink"
              ></span>
            </span>
            <span
              class="font-mono text-[10px] tracking-[0.25em] uppercase text-cream/70"
            >
              QUBIE://REPORT
            </span>
          </div>
          <div
            class="flex items-center gap-2 font-mono text-[10px] tracking-[0.15em] uppercase text-cream/45"
          >
            <span>{qubieTotal} items</span>
            <span class="text-cream/25">·</span>
            <span>refreshes 2&times;/day</span>
          </div>
        </div>

        {/* Inner header — display heading + see-more CTA */}
        <div
          class="flex flex-wrap items-end justify-between gap-6 border-b border-cream/10 px-6 py-6 md:px-8 md:py-8"
        >
          <h2 class={bentoHeading}>
            Latest from the <em class="italic text-pink/90">field</em>.
          </h2>
          <V2Cta
            href={QUBIE_SITE_URL}
            label="See the full feed"
            accent="pink"
            external
          />
        </div>

        <div class="p-5 md:p-6">
          {/* Research wire — top 3, rich cards */}
          {
            qubieResearch.length > 0 && (
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5">
                {qubieResearch.map((a) => {
                  const h = qubieHash(a.link);
                  const docId =
                    "QR-" +
                    h.toString(16).toUpperCase().padStart(8, "0").slice(0, 4);
                  const meter = Math.min(100, Math.max(20, a.score * 7));
                  return (
                    <a
                      href={a.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="qubie-card relative flex flex-col rounded border border-cream/10 bg-plum-deepest/50 p-5"
                    >
                      <div class="mb-4 flex items-center justify-between gap-2 font-mono text-[9px] uppercase tracking-[0.25em]">
                        <span class="text-cream/45">{docId}</span>
                        <span class="text-pink">{a.category.toUpperCase()}</span>
                      </div>
                      <h3 class="font-sans font-semibold text-[15px] leading-snug text-cream line-clamp-3">
                        {a.title}
                      </h3>
                      <p class="mt-2 flex flex-wrap items-center gap-x-2 font-mono text-[10px] tracking-wide text-cream/45">
                        <span>{a.source.split("·")[0].trim()}</span>
                        <span class="text-pink/50">·</span>
                        <span>{a.date}</span>
                      </p>
                      <div class="mt-3 flex items-center gap-3">
                        <div class="relative h-px flex-1 overflow-hidden bg-cream/10">
                          <div
                            class="absolute inset-y-[-1px] left-0 bg-pink"
                            style={`width: ${meter}%`}
                          />
                        </div>
                        <span class="font-mono text-[9px] tracking-[0.2em] text-pink whitespace-nowrap">
                          SCORE {a.score}
                        </span>
                      </div>
                      {a.matchedKeywords.length > 0 && (
                        <div class="mt-3 flex flex-wrap gap-1.5">
                          {a.matchedKeywords.slice(0, 3).map((k) => (
                            <span class="rounded border border-cream/10 px-1.5 py-0.5 font-mono text-[9px] uppercase tracking-wider text-cream/45">
                              {k}
                            </span>
                          ))}
                        </div>
                      )}
                      {a.blurb && (
                        <p class="mt-3 grow font-sans text-[12px] leading-relaxed text-cream/55 line-clamp-3">
                          {a.blurb}
                        </p>
                      )}
                    </a>
                  );
                })}
              </div>
            )
          }

          {/* Chatter strip divider */}
          {
            qubieResearch.length > 0 && qubieChatter.length > 0 && (
              <div class="my-6 md:my-7 flex items-center gap-3">
                <span class="font-mono text-[9px] tracking-[0.3em] uppercase text-cream/50">
                  Chatter
                </span>
                <div class="h-px flex-1 bg-cream/10" />
              </div>
            )
          }

          {/* Chatter — bottom 5, compact vertical panels */}
          {
            qubieChatter.length > 0 && (
              <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-3 lg:grid-cols-5 gap-3 md:gap-4">
                {qubieChatter.map((a) => {
                  const h = qubieHash(a.link);
                  const docId =
                    "QR-" +
                    h.toString(16).toUpperCase().padStart(8, "0").slice(0, 4);
                  const meter = Math.min(100, Math.max(20, a.score * 7));
                  return (
                    <a
                      href={a.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="qubie-mini relative flex flex-col rounded border border-cream/10 bg-plum-deepest/50 p-4"
                    >
                      <div class="mb-3 flex items-center justify-between gap-2 font-mono text-[9px] uppercase tracking-[0.2em]">
                        <span class="text-cream/40">{docId}</span>
                        <span class="text-pink">{a.category.toUpperCase()}</span>
                      </div>
                      <h3 class="font-sans font-medium text-[13px] leading-snug text-cream line-clamp-3">
                        {a.title}
                      </h3>
                      <p class="mt-2 flex flex-wrap items-center gap-x-2 font-mono text-[10px] tracking-wide text-cream/45">
                        <span>{a.source.split("·")[0].trim()}</span>
                        <span class="text-pink/50">·</span>
                        <span>{a.date}</span>
                      </p>
                      <div class="mt-3 flex items-center gap-3">
                        <div class="relative h-px flex-1 overflow-hidden bg-cream/10">
                          <div
                            class="absolute inset-y-[-1px] left-0 bg-pink"
                            style={`width: ${meter}%`}
                          />
                        </div>
                        <span class="font-mono text-[9px] tracking-[0.2em] text-pink whitespace-nowrap">
                          SCORE {a.score}
                        </span>
                      </div>
                      {a.blurb && (
                        <p class="mt-3 grow font-sans text-[12px] leading-relaxed text-cream/55 line-clamp-6">
                          {a.blurb}
                        </p>
                      )}
                    </a>
                  );
                })}
              </div>
            )
          }

          {qubieTotal === 0 && (
            <p class="font-sans text-[14px] text-cream/60 leading-relaxed max-w-2xl">
              Fresh quantum-biology research and chatter — surfaced by Qubie.
              Head over to the Qubie Report for the latest.
            </p>
          )}
        </div>
      </article>

      <!-- ============================================================= -->
      <!-- TEAM                                                    GOLD   -->
      <!-- ============================================================= -->
      <article class={`${bentoCard} lg:col-span-12`}>
        <div class="mb-10">
          <EyebrowLabel accent="pink" class="mb-4">Meet the team</EyebrowLabel>
          <h2 class={bentoHeading}>
            The people <em class="italic text-pink/90">behind</em> the DAO.
          </h2>
        </div>
        <div
          class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-x-6 gap-y-10"
        >
          {
            members.map((person, i) => (
              <button
                type="button"
                data-bio-trigger={`home-${i}`}
                class="group flex flex-col items-center text-center p-4 -m-4 rounded-2xl bg-transparent hover:bg-pink/10 transition-colors cursor-pointer outline-none appearance-none border-0 focus-visible:ring-2 focus-visible:ring-pink focus-visible:ring-offset-2 focus-visible:ring-offset-plum-darkest"
                aria-haspopup="dialog"
                aria-controls={`bio-home-${i}`}
              >
                <div class="w-24 h-24 md:w-28 md:h-28 rounded-full overflow-hidden bg-plum-deepest mb-4 ring-1 ring-cream/10 group-hover:ring-pink transition">
                  <img
                    src={person.img}
                    alt={person.name}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
                <h3 class="font-sans font-semibold text-sm text-cream mb-1">
                  {person.name}
                </h3>
                <p class="font-sans text-[10px] uppercase tracking-[0.18em] text-pink mb-3">
                  {person.role}
                </p>
                <p class="font-sans text-[11px] text-cream/55 leading-relaxed">
                  {person.summary}
                </p>
                <span class="mt-2 font-sans text-[10px] tracking-[0.18em] uppercase text-pink/70 group-hover:text-pink-light transition-colors">
                  Read bio →
                </span>
              </button>
            ))
          }
        </div>
      </article>

      <!-- ============================================================= -->
      <!-- MERCH STORE — curated 4 from Printful                   PINK   -->
      <!-- ============================================================= -->
      <article class={`${bentoCard} lg:col-span-12`}>
        <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
          <div>
            <EyebrowLabel accent="pink" class="mb-2">Merch</EyebrowLabel>
            <h2
              class="font-display text-2xl md:text-3xl leading-[1.05] tracking-tight text-cream"
            >
              Wear the <em class="italic text-pink/90">field</em>.
            </h2>
          </div>
          <V2Cta
            href={MERCH_STORE_URL}
            label="Visit the shop"
            accent="pink"
            external
            size="sm"
          />
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 md:gap-4">
          {
            merchProducts.map((p) => (
              <a
                href={`${MERCH_STORE_URL}product/${p.slug}`}
                target="_blank"
                rel="noopener noreferrer"
                class="group block overflow-hidden rounded-lg border border-cream/10 bg-plum-deepest/30 transition hover:border-pink/40"
              >
                <div class="aspect-[4/3] overflow-hidden bg-plum-deepest/60">
                  <img
                    src={p.imageUrl}
                    alt={p.name}
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                </div>
                <div class="px-3 py-2.5">
                  <h3 class="font-sans font-medium text-[11px] text-cream leading-tight group-hover:text-pink-light transition-colors">
                    {p.name}
                  </h3>
                  <p class="mt-0.5 font-mono text-[9px] tracking-wide text-cream/50">
                    From ${p.minPrice.toFixed(2)}
                  </p>
                </div>
              </a>
            ))
          }
        </div>
      </article>
    </div>
  </div>

  <!-- ====================================================================== -->
  <!-- QUESTIONS CTA                                                          -->
  <!-- ====================================================================== -->
  <section class="relative py-20 md:py-28">
    <div class="max-w-3xl mx-auto px-6 lg:px-12 text-center">
      <EyebrowLabel accent="pink" class="mb-8">Questions</EyebrowLabel>
      <h2
        class="font-display text-3xl sm:text-4xl lg:text-5xl leading-[1.05] tracking-tight text-cream mb-10"
      >
        Still have <em class="italic text-pink/90">questions</em>?
      </h2>
      <div class="inline-flex">
        <V2Cta href="/faqs" label="See all FAQs" accent="pink" />
      </div>
    </div>
  </section>

  <!-- ====================================================================== -->
  <!-- Bio dialogs (modal popups, one per team member)                        -->
  <!-- ====================================================================== -->
  {
    members.map((person, i) => (
      <dialog
        id={`bio-home-${i}`}
        class="bio-dialog p-0 rounded-lg bg-plum-darkest text-cream max-w-2xl w-[92vw] m-auto border border-cream/10"
      >
        <div class="relative p-8 md:p-10">
          <button
            type="button"
            data-bio-close
            aria-label="Close"
            class="absolute top-4 right-4 p-2 rounded-full text-cream/50 hover:text-cream hover:bg-cream/5 transition-colors"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="18" y1="6" x2="6" y2="18" />
              <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
          <div class="flex flex-col sm:flex-row sm:items-center gap-5 mb-6 pr-8">
            <div class="w-20 h-20 shrink-0 rounded-full overflow-hidden bg-plum-deepest ring-1 ring-cream/10">
              <img
                src={person.img}
                alt={person.name}
                class="w-full h-full object-cover"
              />
            </div>
            <div>
              <h3 class="font-display text-2xl text-cream mb-1">
                {person.name}
              </h3>
              <p class="font-sans text-[10px] tracking-[0.18em] uppercase text-pink">
                {person.role}
              </p>
            </div>
          </div>
          <p class="font-sans text-sm md:text-base text-cream/75 leading-relaxed">
            {person.bio}
          </p>
        </div>
      </dialog>
    ))
  }
</V2Layout>

<style is:global>
  /* Dialog backdrop for v2 (dark, blurred to match aesthetic) */
  .bio-dialog::backdrop {
    background-color: rgba(18, 8, 16, 0.75);
    backdrop-filter: blur(4px);
  }

</style>

<script>
  const triggers = document.querySelectorAll<HTMLButtonElement>(
    "[data-bio-trigger]",
  );
  triggers.forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.getAttribute("data-bio-trigger");
      const dialog = document.getElementById(
        `bio-${id}`,
      ) as HTMLDialogElement | null;
      dialog?.showModal();
    });
  });

  const dialogs = document.querySelectorAll<HTMLDialogElement>(".bio-dialog");
  dialogs.forEach((d) => {
    d.addEventListener("click", (e) => {
      if (e.target === d) d.close();
    });
    d.querySelector("[data-bio-close]")?.addEventListener("click", () =>
      d.close(),
    );
  });
</script>
