---
import V2Layout from "../components/v2/V2Layout.astro";
import V2Cta from "../components/v2/V2Cta.astro";
import EyebrowLabel from "../components/v2/EyebrowLabel.astro";
import { labelBase, bentoCard } from "../lib/v2-bg";
import { dotGraphic } from "../lib/dot-graphic";

// Five "popular examples" illustrations — linework members of the solid-
// glyph icon family ("Set C", the site-wide standard): bold geometric
// strokes (3 in a 120 viewBox ≈ the glyphs' weight at this ~220px cell
// size) with solid-filled focal elements. Redrawn 2026-08 per Olli.
const examples: { label: string; svg: string }[] = [
  {
    label: "Photosynthesis",
    svg: `<svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="#d57db2" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="30" cy="28" r="8" fill="#d57db2" stroke="none"/>
      <line x1="30" y1="10" x2="30" y2="16"/>
      <line x1="30" y1="40" x2="30" y2="46"/>
      <line x1="12" y1="28" x2="18" y2="28"/>
      <line x1="42" y1="28" x2="48" y2="28"/>
      <line x1="17" y1="15" x2="21.5" y2="19.5"/>
      <line x1="38.5" y1="36.5" x2="43" y2="41"/>
      <line x1="43" y1="15" x2="38.5" y2="19.5"/>
      <line x1="21.5" y1="36.5" x2="17" y2="41"/>
      <path d="M88 42 C 106 60, 104 88, 78 104 C 56 92, 52 62, 66 48 C 72 42, 80 40, 88 42 Z"/>
      <path d="M84 48 Q 76 72, 72 98"/>
      <line x1="80" y1="60" x2="67" y2="57"/>
      <line x1="76" y1="76" x2="62" y2="74"/>
      <line x1="80" y1="62" x2="93" y2="57"/>
      <line x1="75" y1="80" x2="89" y2="77"/>
    </svg>`,
  },
  {
    label: "Bird navigation",
    svg: `<svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="#d57db2" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 26 Q60 8, 106 26"/>
      <path d="M10 40 Q60 20, 110 40"/>
      <path d="M6 54 Q60 32, 114 54"/>
      <ellipse cx="54" cy="86" rx="22" ry="11"/>
      <circle cx="76" cy="79" r="8" fill="#d57db2" stroke="none"/>
      <path d="M83 76 L97 75 L84 83 Z" fill="#d57db2" stroke="none"/>
      <path d="M33 84 L17 76 L21 92 Z" fill="#d57db2" stroke="none"/>
      <path d="M50 76 Q 42 62, 32 56"/>
      <path d="M56 76 Q 54 60, 47 52"/>
    </svg>`,
  },
  {
    label: "DNA repair",
    svg: `<svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="#d57db2" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <path d="M44 14 C 44 35, 76 35, 76 56 C 76 77, 44 77, 44 98"/>
      <path d="M76 14 C 76 35, 44 35, 44 56 C 44 77, 76 77, 76 98"/>
      <line x1="47" y1="19" x2="73" y2="19"/>
      <line x1="50" y1="27" x2="70" y2="27"/>
      <line x1="50" y1="85" x2="70" y2="85"/>
      <line x1="47" y1="93" x2="73" y2="93"/>
      <g fill="#d57db2" stroke="none">
        <circle cx="60" cy="35" r="4"/>
        <circle cx="60" cy="77" r="4"/>
        <circle cx="44" cy="14" r="3"/>
        <circle cx="76" cy="14" r="3"/>
        <circle cx="44" cy="98" r="3"/>
        <circle cx="76" cy="98" r="3"/>
      </g>
    </svg>`,
  },
  {
    label: "Magnetic sensitivity",
    svg: `<svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="#d57db2" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <rect x="52" y="42" width="16" height="36" rx="8" fill="#d57db2" stroke="none"/>
      <path d="M60 24 C 34 24, 34 96, 60 96"/>
      <path d="M60 24 C 86 24, 86 96, 60 96"/>
      <path d="M60 10 C 22 10, 22 110, 60 110"/>
      <path d="M60 10 C 98 10, 98 110, 60 110"/>
      <circle cx="60" cy="24" r="4" fill="#d57db2" stroke="none"/>
      <circle cx="60" cy="96" r="4" fill="#d57db2" stroke="none"/>
    </svg>`,
  },
  {
    label: "Sense of smell",
    svg: `<svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="#d57db2" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <line x1="25" y1="66" x2="45" y2="50"/>
      <line x1="45" y1="50" x2="65" y2="66"/>
      <line x1="25" y1="66" x2="45" y2="82"/>
      <line x1="65" y1="66" x2="45" y2="82"/>
      <line x1="45" y1="50" x2="45" y2="32"/>
      <g fill="#d57db2" stroke="none">
        <circle cx="25" cy="66" r="5.5"/>
        <circle cx="45" cy="50" r="5"/>
        <circle cx="65" cy="66" r="5.5"/>
        <circle cx="45" cy="82" r="5"/>
        <circle cx="45" cy="32" r="4.5"/>
      </g>
      <path d="M80 50 Q88 58, 96 50 Q104 42, 112 50"/>
      <path d="M78 66 Q86 74, 94 66 Q102 58, 110 66"/>
      <path d="M80 82 Q88 90, 96 82 Q104 74, 112 82"/>
    </svg>`,
  },
];

// Horizontal timeline beats — matches the four events called out in the
// brief-history copy (1920s/30s birth of QM → 1944 Schrödinger → 1960s
// tunneling + bird nav → today's quantum-probe instruments).
const timelineEvents = [
  {
    year: "1920's–30's",
    title: "Quantum physics born",
    caption:
      "Scientists begin searching for ways to apply quantum ideas in biology.",
  },
  {
    year: "1944",
    title: "What is Life?",
    caption:
      "Schrödinger postulates the need for quantum mechanics to explain heredity, prior to the discovery of DNA.",
  },
  {
    year: "1960's",
    title: "First evidence",
    caption:
      "Researchers find natural phenomena depending on quantum effects — tunneling in enzymes, bird navigation.",
  },
  {
    year: "Now",
    title: "Probing quantum states",
    caption:
      "Researchers aim to construct new instruments to directly probe quantum states and unlock the quantum secrets of life.",
  },
];

// Reversible off-switches (same pattern as SHOW_MERCH on the homepage):
// the briefs ("Paths to commercialization") and tadpole-study links have no
// URLs yet, so they're hidden until someone supplies them — flip the flag
// and fill in the href to bring one back.
const SHOW_BRIEFS_LINK = false;
const SHOW_TADPOLE_LINK = false;

const foundations = [
  { label: "FAQ", href: "/faqs", external: false },
  {
    label: "Vision paper",
    href: "https://drive.google.com/file/d/1FCLowcfBJYEAOneG6ohlpcOL04Oym91G/view",
    external: true,
  },
  { label: "The DAO, explained", href: "/explainer", external: true },
  { label: "QBio Ecosystem roadmap", href: "/roadmap", external: true },
  ...(SHOW_BRIEFS_LINK
    ? [{ label: "Paths to commercialization", href: "#", external: false }]
    : []),
  ...(SHOW_TADPOLE_LINK
    ? [{ label: "QBI study — tadpole", href: "#", external: false }]
    : []),
  {
    label: "The origins of quantum biology",
    href: "https://pmc.ncbi.nlm.nih.gov/articles/PMC6304024/",
    external: true,
  },
  {
    label: "SciAm: Bird navigation",
    href: "https://www.scientificamerican.com/article/how-migrating-birds-use-quantum-effects-to-navigate/",
    external: true,
  },
];

// Chris Rourk's quote removed 2026-08 — he's no longer the Science Working
// Group leader (per Kyra). Replacements pending: a quote from Jonathan
// Heppner (interim SWG leader), and ideally someone other than Zicjoe
// (who is quoted on other pages) — Kyra suggested Nahuel.
const testimonials = [
  {
    quote:
      "The research we're supporting isn't abstract, it's about unlocking discoveries that impact life itself. Advancing quantum biology through grants ensures ideas with potential don't stay trapped in theory, and the granting process here feels transparent, mission-driven, and built to accelerate breakthroughs.",
    author: "Zicjoe",
    role: "DAO Community Member",
  },
];

// Hero neuron — kept from the previous design.
const neuronDotsSvg = await dotGraphic("public/images/graphics/neuron.png", {
  color: "#ffceec",
});
---

<V2Layout
  title="Science — Quantum Biology DAO"
  description="Learn what quantum biology is and how we're building a new, decentralized process to fund its most important experiments."
>
  <!-- ====================================================================== -->
  <!-- 01 — HERO  (neuron anchored top-right, headline on the left)            -->
  <!-- ====================================================================== -->
  <section class="relative pb-16 md:pb-24">
    <div
      class="absolute top-0 right-0 w-[110%] sm:w-[88%] lg:w-[77%] xl:w-[70%] translate-x-[30%] lg:translate-x-[10%] pointer-events-none opacity-[0.37] [&_svg]:block [&_svg]:w-full [&_svg]:max-w-none"
      set:html={neuronDotsSvg}
      aria-label="Branching neuron rendered as a field of dots"
    >
    </div>

    <div class="relative max-w-7xl mx-auto px-6 lg:px-12 pt-28 lg:pt-32 z-10">
      <div class="lg:max-w-[52%]">
        <p class={`${labelBase} text-pink`}>Science</p>
        <h1
          class="font-display text-5xl sm:text-6xl lg:text-7xl xl:text-[5rem] leading-[0.95] tracking-tight text-cream-warm"
        >
          The science
          <span class="block">
            <em class="font-display italic text-pink/90">&amp;</em> the system.
          </span>
        </h1>
        <p
          class="mt-8 font-sans text-[14px] text-cream leading-relaxed max-w-md"
        >
          Learn what quantum biology is and how we're building a new,
          decentralized process to fund its most important experiments.
        </p>
        <div class="mt-10">
          <V2Cta
            href="https://quantumbiology.community"
            label="Join the working group"
            accent="pink"
            external
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ====================================================================== -->
  <!-- 02 — WHAT IS QUANTUM BIOLOGY  (prose + spin-pair pull quote)            -->
  <!-- ====================================================================== -->
  <section class="relative py-6 md:py-8">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <article class={bentoCard}>
      <div class="max-w-3xl mx-auto">
      <EyebrowLabel accent="pink">Foundations</EyebrowLabel>
      <h2
        class="font-display text-4xl md:text-5xl leading-[1.05] tracking-tight text-cream-warm mb-8"
      >
        What is <em class="italic text-pink/90">quantum</em> biology?
      </h2>
      <div
        class="font-sans text-[15px] text-cream leading-relaxed space-y-5"
      >
        <p>
          Quantum biology is an emerging scientific field that explores how life
          depends on quantum phenomena.
        </p>
        <p>
          At its core, it studies how superposition, electron spin, entanglement,
          and quantum tunneling can influence the molecules, cells, and systems
          of living organisms.
        </p>
      </div>

      <!-- Pull quote: spin-pair motif -->
      <aside class="my-14 md:my-16 flex items-center gap-6 justify-center">
        <svg
          width="56"
          height="56"
          viewBox="0 0 60 60"
          fill="none"
          stroke="#d57db2"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="shrink-0"
          aria-hidden="true"
        >
          <line x1="20" y1="10" x2="20" y2="50"></line>
          <polyline points="13,17 20,10 27,17"></polyline>
          <line x1="40" y1="10" x2="40" y2="50"></line>
          <polyline points="33,43 40,50 47,43"></polyline>
        </svg>
        <blockquote
          class="font-display italic text-2xl md:text-3xl text-cream/90 leading-[1.2]"
        >
          Biology was treated as <span class="text-pink">too messy</span> for
          these delicate phenomena. That assumption is breaking down.
        </blockquote>
      </aside>

      <div
        class="font-sans text-[15px] text-cream leading-relaxed space-y-5"
      >
        <p>
          Researchers have found quantum effects at work in photosynthesis,
          bird navigation, enzyme catalysis, and more. Now, many are wondering
          if quantum physics holds the key to explaining cellular metabolism,
          rejuvenation, consciousness, and the origin of life.
        </p>
      </div>
      </div>
      </article>
    </div>
  </section>

  <!-- ====================================================================== -->
  <!-- 03 — A BRIEF HISTORY  (prose + wavy timeline + wave pull quote)         -->
  <!-- ====================================================================== -->
  <section class="relative py-6 md:py-8">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <article class={bentoCard}>
      <div class="max-w-3xl mx-auto">
        <EyebrowLabel accent="pink">History</EyebrowLabel>
        <h2
          class="font-display text-4xl md:text-5xl leading-[1.05] tracking-tight text-cream-warm mb-8"
        >
          A brief <em class="italic text-pink/90">history</em>.
        </h2>
        <div
          class="font-sans text-[15px] text-cream leading-relaxed space-y-5"
        >
          <p>
            Soon after the birth of quantum physics in the 1920s and 30s,
            scientists began searching for ways to apply quantum ideas in
            biology. Erwin Schrödinger, one of the fathers of quantum theory,
            wrote "What is Life?" in 1944, postulating the need for quantum
            mechanics to explain heredity, prior to the discovery of DNA. In
            the 1960s and 70s, researchers began finding examples of natural
            phenomena, including tunneling in enzymes and bird navigation,
            which depended on quantum phenomena. Now, researchers are aiming
            to construct new instruments to directly probe quantum states and
            help unlock the quantum secrets of life.
          </p>
        </div>
      </div>

      <!-- Wavy horizontal timeline -->
      <div class="mt-14 md:mt-20 relative">
        <!-- Decorative wave behind the beats -->
        <svg
          class="absolute inset-x-0 top-12 w-full h-32 pointer-events-none"
          viewBox="0 0 1200 120"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path
            d="M0 60 Q150 15, 300 60 T 600 60 T 900 60 T 1200 60"
            stroke="#d57db2"
            stroke-width="1.5"
            fill="none"
            opacity="0.45"
            stroke-dasharray="2 6"
          ></path>
        </svg>

        <div
          class="relative grid grid-cols-2 lg:grid-cols-4 gap-y-12 gap-x-6"
        >
          {
            timelineEvents.map((event) => (
              <div class="text-center px-2">
                <p class="font-sans text-[11px] tracking-[0.3em] uppercase text-pink mb-3">
                  {event.year}
                </p>
                <div class="flex justify-center mb-4">
                  <span class="relative inline-flex">
                    <span class="absolute inset-0 rounded-full bg-pink/25 blur-sm" />
                    <span class="relative w-3.5 h-3.5 rounded-full bg-pink ring-4 ring-plum-darkest" />
                  </span>
                </div>
                <p class="font-display text-base md:text-lg text-cream-warm mb-2 leading-tight">
                  {event.title}
                </p>
                <p class="font-sans text-[12.5px] text-cream/60 leading-snug max-w-[18ch] mx-auto">
                  {event.caption}
                </p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Pull quote: wave motif -->
      <aside
        class="mt-16 md:mt-20 max-w-3xl mx-auto flex items-center gap-6 justify-center"
      >
        <svg
          width="56"
          height="56"
          viewBox="0 0 60 60"
          fill="none"
          stroke="#d57db2"
          stroke-width="3"
          stroke-linecap="round"
          class="shrink-0"
          aria-hidden="true"
        >
          <path d="M5 30 Q15 12, 25 30 T 45 30 Q50 22, 55 30"></path>
        </svg>
        <blockquote
          class="font-display italic text-2xl md:text-3xl text-cream/90 leading-[1.2]"
        >
          Schrödinger postulated quantum mechanics in life —
          <span class="text-pink">before DNA was discovered</span>.
        </blockquote>
      </aside>
      </article>
    </div>
  </section>

  <!-- ====================================================================== -->
  <!-- 04 — OUR FOCUS                                                           -->
  <!-- ====================================================================== -->
  <section class="relative py-6 md:py-8">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <article class={bentoCard}>
      <div class="max-w-3xl mx-auto">
      <EyebrowLabel accent="pink">Our focus</EyebrowLabel>
      <h2
        class="font-display text-4xl md:text-5xl leading-[1.05] tracking-tight text-cream-warm mb-8"
      >
        What kind of <em class="italic text-pink/90">quantum biology</em>
        are we interested in?
      </h2>
      <div
        class="font-sans text-[15px] text-cream leading-relaxed space-y-5"
      >
        <p>
          There are many "flavors" of quantum biology — from birds navigating
          magnetic fields, to quantum coherence in photosynthesis, to theories
          of consciousness in microtubules.
        </p>
        <p>
          At the Quantum Biology DAO, we're especially focused on
          experimentally testable quantum effects with real-world relevance and
          clear theoretical grounding.
        </p>
        <p>
          So far, we've been particularly interested in two areas:
          <span class="text-pink">low-field magnetic effects</span>
          and <span class="text-pink">the radical pair mechanism</span>. These
          make specific predictions and could explain phenomena from tadpole
          development to human fertility.
        </p>
      </div>

      <!-- Pull quote: dipole motif -->
      <aside class="mt-14 md:mt-16 flex items-center gap-6 justify-center">
        <svg
          width="56"
          height="56"
          viewBox="0 0 60 60"
          fill="none"
          stroke="#d57db2"
          stroke-width="2.6"
          stroke-linecap="round"
          class="shrink-0"
          aria-hidden="true"
        >
          <ellipse cx="30" cy="30" rx="12" ry="22"></ellipse>
          <ellipse cx="30" cy="30" rx="20" ry="22"></ellipse>
          <circle cx="30" cy="8" r="3" fill="#d57db2"></circle>
          <circle cx="30" cy="52" r="3" fill="#d57db2"></circle>
        </svg>
        <blockquote
          class="font-display italic text-2xl md:text-3xl text-cream/90 leading-[1.2]"
        >
          From <span class="text-pink">tadpole development</span> to human
          fertility.
        </blockquote>
      </aside>
      </div>
      </article>
    </div>
  </section>

  <!-- ====================================================================== -->
  <!-- 05 — POPULAR EXAMPLES  (5-up illustration row)                          -->
  <!-- ====================================================================== -->
  <section class="relative py-6 md:py-8">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <article class={bentoCard}>
      <div class="max-w-3xl mb-12 md:mb-16">
        <EyebrowLabel accent="pink">In the wild</EyebrowLabel>
        <h2
          class="font-display text-3xl md:text-4xl leading-[1.05] tracking-tight text-cream-warm"
        >
          Popular <em class="italic text-pink/90">examples</em>.
        </h2>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6">
        {
          examples.map((ex) => (
            <div class="flex flex-col items-center text-center">
              <div
                class="w-full aspect-square mb-4 [&_svg]:block [&_svg]:w-full [&_svg]:h-full"
                set:html={ex.svg}
              />
              <p class="font-display text-base md:text-lg text-cream-warm leading-tight">
                {ex.label}
              </p>
            </div>
          ))
        }
      </div>
      </article>
    </div>
  </section>

  <!-- ====================================================================== -->
  <!-- 06 — EXPLORE THE FOUNDATIONS  (4-up pill row)                           -->
  <!-- ====================================================================== -->
  <section class="relative py-6 md:py-8">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <article class={bentoCard}>
      <div class="max-w-3xl mb-10 md:mb-12">
        <EyebrowLabel accent="pink">Further reading</EyebrowLabel>
        <h2
          class="font-display text-3xl md:text-4xl leading-[1.05] tracking-tight text-cream-warm"
        >
          Explore the <em class="italic text-pink/90">foundations</em>.
        </h2>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
        {
          foundations.map((f) => (
            <a
              href={f.href}
              target={f.external ? "_blank" : undefined}
              rel={f.external ? "noopener noreferrer" : undefined}
              class="group flex items-center justify-between gap-3 rounded-md border border-cream/10 hover:border-pink/40 hover:bg-pink/5 transition-colors px-4 py-4"
            >
              <span class="font-sans text-[13px] text-cream/85 leading-snug">
                {f.label}
              </span>
              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-pink opacity-60 group-hover:opacity-100 shrink-0"
                aria-hidden="true"
              >
                {f.external ? (
                  <>
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    <polyline points="15 3 21 3 21 9" />
                    <line x1="10" y1="14" x2="21" y2="3" />
                  </>
                ) : (
                  <>
                    <path d="M5 12h14" />
                    <polyline points="12 5 19 12 12 19" />
                  </>
                )}
              </svg>
            </a>
          ))
        }
      </div>
      </article>
    </div>
  </section>

  <!-- ====================================================================== -->
  <!-- 07 — INSTITUTE  (left lockup + right copy + CTA)                        -->
  <!-- ====================================================================== -->
  <section class="relative py-6 md:py-8">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <article class={bentoCard}>
      <EyebrowLabel accent="teal">Flagship grant</EyebrowLabel>
      <div
        class="grid lg:grid-cols-[1fr_1.2fr] gap-10 lg:gap-14 items-center mt-2"
      >
        <div class="aspect-square rounded-lg overflow-hidden">
          <img
            src="/images/brand/qbi-institute-lockup.png"
            alt="Quantum Biology Institute"
            class="w-full h-full object-cover"
          />
        </div>
        <div>
          <h2
            class="font-display text-3xl md:text-4xl leading-[1.05] tracking-tight text-cream-warm mb-6"
          >
            The Quantum Biology
            <em class="italic text-teal/90">Institute</em>.
          </h2>
          <div
            class="font-sans text-[14px] text-cream leading-relaxed space-y-4"
          >
            <p>
              We made the largest grant for quantum biological instrumentation
              in history to the Quantum Biology Institute — a nonprofit lab in
              Los Angeles funding real scientists doing real experiments.
            </p>
            <p>
              The Institute is building a quantum microscope to detect electron
              spin states inside live cells.
            </p>
          </div>
          <div class="mt-8 flex flex-col items-start gap-5">
            <V2Cta
              href="https://quantumbiology.org"
              label="Visit the Institute"
              accent="teal"
              external
            />
            <p class="font-sans text-[12px] text-cream/60 leading-relaxed">
              The Quantum Biology Institute is committed to an open science
              model of research. To view all their previous and ongoing work,
              check out
              <a
                href="https://data.quantumbiology.org/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-teal hover:text-teal/80 underline underline-offset-2"
