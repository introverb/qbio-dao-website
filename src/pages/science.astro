---
import V2Layout from "../components/v2/V2Layout.astro";
import V2Cta from "../components/v2/V2Cta.astro";
import EyebrowLabel from "../components/v2/EyebrowLabel.astro";
import { labelBase, bentoCard } from "../lib/v2-bg";
import { dotGraphic } from "../lib/dot-graphic";

// Five "popular examples" illustrations — clean pink linework at the same
// stroke weight as the small pull-quote motifs (spin pair, wave, dipole).
// Sleeker than the dot-graphic treatment used for the hero heros, which
// turned mushy at this display size (~220px per cell).
const examples: { label: string; svg: string }[] = [
  {
    label: "Photosynthesis",
    svg: `<svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="#d57db2" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round">
      <path d="M10 27 L23 16 L37 27 L47 15 L60 25" stroke-opacity="0.88" stroke-dasharray="2.2 0.35 1.6 0.2"/>
      <path d="M54 20 L65 28 L56 33" stroke-opacity="0.82"/>
      <path d="M82 31 C60 40, 49 63, 56 89 C62 104, 81 110, 96 100 C112 92, 118 71, 112 55 C107 40, 95 29, 82 31 Z" stroke-opacity="0.9" stroke-width="1.2" stroke-dasharray="2.4 0.4"/>
      <path d="M84 34 C63 43, 51 64, 58 89 C63 103, 79 108, 94 98 C110 90, 115 71, 110 57 C105 43, 95 33, 84 34" stroke-opacity="0.32" stroke-width="0.7"/>
