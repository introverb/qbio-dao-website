              <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-pink opacity-60 group-hover:opacity-100 shrink-0"
                aria-hidden="true"
              >
                {f.external ? (
                  <>
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    <polyline points="15 3 21 3 21 9" />
                    <line x1="10" y1="14" x2="21" y2="3" />
                  </>
                ) : (
                  <>
                    <path d="M5 12h14" />
                    <polyline points="12 5 19 12 12 19" />
                  </>
                )}
              </svg>
            </a>
          ))
        }
      </div>
      </article>
    </div>
