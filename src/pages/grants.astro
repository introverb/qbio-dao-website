---
import V2Layout from "../components/v2/V2Layout.astro";
import V2Cta from "../components/v2/V2Cta.astro";
import EyebrowLabel from "../components/v2/EyebrowLabel.astro";
import { bentoCard, bentoHeading } from "../lib/v2-bg";

// Placeholder copy — real content TBD.
const lorem1 =
  "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.";
const lorem2 =
  "Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.";
const lorem3 =
  "Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam, eaque ipsa quae ab illo inventore veritatis et quasi architecto beatae vitae dicta sunt explicabo.";
---

<V2Layout
  title="Grants — Quantum Biology DAO"
  description="Funding open quantum biology research through community grants."
>
  <!-- ====================================================================== -->
  <!-- HERO  —  title block on the left (graphic intentionally removed)        -->
  <!-- ====================================================================== -->
  <section class="relative pb-16 md:pb-24">
    <div class="relative max-w-7xl mx-auto px-6 lg:px-12 pt-8 lg:pt-40 z-10">
      <div class="max-w-3xl">
        <EyebrowLabel accent="pink">Grants</EyebrowLabel>
        <h1
          class="font-display text-5xl sm:text-6xl lg:text-7xl xl:text-[5rem] leading-[0.95] tracking-tight text-cream"
        >
          Funding
          <em class="italic text-pink/90">open</em>
          <span class="block">science.</span>
        </h1>
        <p
          class="mt-8 font-sans text-[15px] text-cream/65 leading-relaxed max-w-xl"
        >
          {lorem1}
        </p>
        <div class="mt-10 flex flex-col items-start gap-5">
          <V2Cta
            href="/science#granting"
            label="Our granting process"
            accent="pink"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ====================================================================== -->
  <!-- PLACEHOLDER BODY PANELS                                                 -->
  <!-- ====================================================================== -->
  <div class="relative max-w-7xl mx-auto px-6 lg:px-12 pb-16 md:pb-24">
    <div class="grid lg:grid-cols-12 gap-6 lg:gap-7 auto-rows-auto">
      <!-- ============================================================= -->
      <!-- FEATURED GRANTEE (moved from homepage)                  TEAL   -->
      <!-- ============================================================= -->
      <article class={`${bentoCard} lg:col-span-12`}>
        <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
          <div class="lg:col-span-7">
            <EyebrowLabel accent="teal">Featured grantee</EyebrowLabel>
            <h2 class={`${bentoHeading} mb-6`}>
              The <em class="italic text-teal/90">Quantum Biology Institute</em>.
            </h2>
            <p
              class="font-sans text-[14px] text-cream/70 leading-relaxed max-w-2xl mb-10"
            >
              We engage researchers, crypto enthusiasts, industry experts, and
              the general public to accelerate the quantum biology revolution.
              Our flagship grant funds the Institute's experimental work
              probing quantum effects in living systems.
            </p>
            <div class="flex flex-col items-start gap-5">
              <V2Cta
                href="https://quantumbiology.org"
                label="The Institute"
                accent="teal"
                external
              />
              <V2Cta
                href="/science#granting"
                label="Granting process"
                accent="pink"
              />
            </div>
          </div>
          <div class="lg:col-span-5">
            <div class="aspect-square rounded-lg overflow-hidden">
              <img
                src="/images/brand/qbi-institute-lockup.png"
                alt="Quantum Biology Institute"
                class="w-full h-full object-cover"
              />
            </div>
          </div>
        </div>
      </article>

      <article class={`${bentoCard} lg:col-span-12`}>
        <EyebrowLabel accent="pink">Placeholder</EyebrowLabel>
        <div class="grid lg:grid-cols-12 gap-10 lg:gap-12">
          <div class="lg:col-span-6">
            <h2 class={bentoHeading}>
              Section <em class="italic text-pink/90">heading</em> goes here.
            </h2>
          </div>
          <div
            class="lg:col-span-6 font-sans text-[14px] text-cream/70 leading-relaxed space-y-4"
          >
            <p>{lorem2}</p>
            <p>{lorem3}</p>
          </div>
        </div>
      </article>

      <article class={`${bentoCard} lg:col-span-12`}>
        <EyebrowLabel accent="pink">Placeholder</EyebrowLabel>
        <h2 class={`${bentoHeading} mb-6 max-w-3xl`}>
          Another <em class="italic text-pink/90">section</em>.
        </h2>
        <p
          class="font-sans text-[14px] text-cream/70 leading-relaxed max-w-3xl"
        >
          {lorem1} {lorem2}
        </p>
      </article>
    </div>
  </div>

  <!-- ====================================================================== -->
  <!-- QUESTIONS                                                              -->
  <!-- ====================================================================== -->
  <section class="relative py-20 md:py-28">
    <div class="max-w-3xl mx-auto px-6 lg:px-12 text-center">
      <EyebrowLabel accent="pink" class="mb-8">Questions</EyebrowLabel>
      <h2
        class="font-display text-3xl sm:text-4xl lg:text-5xl leading-[1.05] tracking-tight text-cream mb-10"
      >
        Still have <em class="italic text-pink/90">questions</em>?
      </h2>
      <div class="inline-flex">
        <V2Cta href="/faqs" label="See all FAQs" accent="pink" />
      </div>
    </div>
  </section>
</V2Layout>
